{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "OpenSky API Polling Success & Failure Rates",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(airguard_opensky_poll_success_total[1m])",
          "legendFormat": "Success Rate",
          "refId": "A"
        },
        {
          "expr": "rate(airguard_opensky_poll_failure_total[1m])",
          "legendFormat": "Failure Rate",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Active WebSocket Client Connections",
      "type": "gauge",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "airguard_active_websockets",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Pipeline Processing Latency by Stage (p95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(airguard_pipeline_stage_latency_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "{{stage}} (p95)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "Redis Stream Queue Size Backlog",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "airguard_queue_depth",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "title": "FastAPI HTTP Request Latency by Endpoint (p95)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(airguard_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}} (p95)",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["production", "airguard"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s"
    ]
  },
  "timezone": "",
  "title": "AirGuard Ground Station Telemetry Dashboard",
  "uid": "airguard-telemetry",
  "version": 1
}
