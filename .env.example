# Docker Compose settings for local development (copy to .env at repository root).
POSTGRES_DB=airguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
LOG_LEVEL=INFO

# Create an OAuth2 API client in your OpenSky account and enter its credentials.
# Without these values, AirGuard uses anonymous OpenSky access with lower quotas.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
