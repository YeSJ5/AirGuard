# AirGuard Environment Configuration Example

# Postgres Container Configuration
POSTGRES_DB=airguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/airguard
REDIS_URL=redis://redis:6379/0
JAEGER_HOST=jaeger
LOG_LEVEL=INFO
RUN_INGESTION=true
SECRET_KEY=SUPER_SECRET_TACTICAL_KEY_123!

# OpenSky API Configuration (Optional: set credentials for higher rate limits)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_GLOBAL_VIEW=true
# Optional: defaults to 90s authenticated and 900s anonymous for global-query quota.
# OPENSKY_POLL_INTERVAL_SECONDS=90
MONITOR_REGION=Global
