{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Frontend Dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "airguard"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Backend Dev",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --reload --port 8001",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "airguard"
      },
      "problemMatcher": []
    }
  ]
}
