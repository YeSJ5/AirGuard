# AirGuard Backend Configuration Example
ENV=dev
PROJECT_NAME=AirGuard
API_V1_STR=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:12345@127.0.0.1:5432/airguard
SECRET_KEY=SUPER_SECRET_TACTICAL_KEY_123!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REDIS_URL=redis://127.0.0.1:6379/0
JAEGER_HOST=127.0.0.1
LOG_LEVEL=INFO

# OpenSky API Configuration
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_LAMIN=6.0
OPENSKY_LOMIN=68.0
OPENSKY_LAMAX=37.0
OPENSKY_LOMAX=98.0
OPENSKY_GLOBAL_VIEW=true
# Optional: defaults to 90s authenticated and 900s anonymous for global-query quota.
# OPENSKY_POLL_INTERVAL_SECONDS=90
MONITOR_REGION=Global
RUN_INGESTION=true
